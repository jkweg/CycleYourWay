# OpenRouteService / HeiGIT — wymagane (https://openrouteservice.org/dev/#/signup)
# Directions: https://api.heigit.org/openrouteservice (stara domena wyłączana 24.08.2026)
ORS_API_KEY=
# Opcjonalne nadpisanie baz URL (bez trailing slash)
# ORS_DIRECTIONS_BASE=https://api.heigit.org/openrouteservice/v2/directions
# ORS_PELIAS_BASE=https://api.heigit.org/pelias/v1

# Dokładne originy frontendu (przecinek, bez końcowego /). Lista ZASTĘPUJE domyślne.
# Preview Vercela dodaj osobno. Wildcard *.vercel.app nie jest obsługiwany.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://cycleyourway.pl,https://www.cycleyourway.pl,capacitor://localhost,https://localhost

# Bezpiecznik faktycznych wywołań ORS, razem z retry i kandydatami pętli.
# Okna kroczące 60 s / 24 h; liczniki W RAM jednego procesu, resetowane przy restarcie.
# Nie zastępuje wspólnego, trwałego limitera przy wielu instancjach lub innym użyciu klucza.
# Podnoś wyłącznie zgodnie z przyznanym planem dostawcy.
# ORS_DIRECTIONS_PER_MINUTE=40
# ORS_DIRECTIONS_PER_DAY=2000
# ORS_DIRECTIONS_CONCURRENCY=4
# ORS_GEOCODE_PER_MINUTE=100
# ORS_GEOCODE_PER_DAY=3000
# ORS_GEOCODE_CONCURRENCY=6

# Render/Railway ustawiają PORT automatycznie — nie musisz go wpisywać lokalnie
# PORT=5000
