{
  "appId": "com.cycleyourway.app",
  "appName": "Cycle Your Way",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "cycleyourway.pl",
      "*.cycleyourway.pl",
      "*.supabase.co"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#2A1A12",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    }
  }
}
