# TYLKO adres projektu — BEZ /rest/v1/ na końcu!
# Settings → General → Project URL
VITE_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co

# Publishable key z Settings → API Keys (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Backend ORS (lokalnie lub Railway/Render)
VITE_API_URL=http://localhost:5000

# Opcjonalnie: Sentry (crash reporting)
# VITE_SENTRY_DSN=https://...@o....ingest.sentry.io/...

# Opcjonalnie: komercyjne kafelki map (MapTiler / Stadia). Bez tego prod używa OSM.
# VITE_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_TILES_ATTR=© MapTiler © OpenStreetMap contributors

# Publiczny origin frontendu (deep links / OAuth redirects) — produkcja:
VITE_APP_ORIGIN=https://cycleyourway.pl

# v2 background GPS (wymaga: npm i @capacitor-community/background-geolocation + uprawnienia w AndroidManifest)
# VITE_ENABLE_BG_GPS=true
